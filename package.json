{
  "name": "recall",
  "private": true,
  "version": "0.1.0-beta.1",
  "description": "Windows-first local-first desktop search for screenshots, documents, and voice recordings.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HQxMANu/RECALL.git"
  },
  "bugs": {
    "url": "https://github.com/HQxMANu/RECALL/issues"
  },
  "homepage": "https://github.com/HQxMANu/RECALL",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tauri": "tauri dev",
    "prepare:models": "python .\\scripts\\prepare_local_models.py --model-root .\\python\\models",
    "build:runtime": "powershell -ExecutionPolicy Bypass -File .\\scripts\\prepare-worker-runtime.ps1",
    "build:desktop": "npm run build:runtime && npm run build",
    "build": "tsc -b && vite build",
    "package:portable": "powershell -ExecutionPolicy Bypass -File .\\scripts\\package-portable.ps1",
    "build:portable": "npm run build:desktop && cargo build --manifest-path src-tauri/Cargo.toml --release && npm run package:portable",
    "build:tauri": "npm run build:portable",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:python": "python -m unittest discover -s python/tests -t python",
    "smoke:runtime": "python .\\scripts\\smoke_worker_runtime.py --runtime-root .\\src-tauri\\resources\\python",
    "validate:release": "npm run lint && npm run build:runtime && npm run build && cargo check --manifest-path src-tauri/Cargo.toml && npm run test:python"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
